export GIT_COMMIT_SHA = $(shell git rev-parse HEAD)

IMAGE_REPO ?= docker.io/<dockerhub-user>/mlb-data-pipeline
IMAGE_TAG ?= ${GIT_COMMIT_SHA}
IMAGE ?= ${IMAGE_REPO}:${IMAGE_TAG}
CURRENT_YEAR ?= $(shell date +%Y)
PYTHON ?= python3
VENV_DIR ?= .venv
VENV_PYTHON ?= ${VENV_DIR}/bin/python
RUN_PYTHON ?= $(if $(wildcard ${VENV_PYTHON}),${VENV_PYTHON},${PYTHON})
START_SEASON ?= 2024
END_SEASON ?= 2024
OUTPUT_DIR ?= $(CURDIR)/output
SAMPLE_MODE ?= false
SAMPLE_START_DATE ?=
SAMPLE_END_DATE ?=
SAMPLE_MAX_ROWS ?= 20000
SAMPLE_MAX_WINDOWS ?= 2
SAMPLE_RANDOM_STATE ?= 42
INCREMENTAL_MODE ?= true
REQUIRE_EXISTING_SNAPSHOT ?= false
TRAILER_MONTHS ?= 1
LAHMAN_ENABLED ?= false
LAHMAN_START_SEASON ?= 1871
LAHMAN_END_SEASON ?= 2014
LAHMAN_PLAYER_MAPPING_PATH ?=
LAHMAN_INCLUDE_OVERLAP ?= false
SOURCE_OVERLAP_POLICY ?= statcast_preferred
PRETTY_LOCAL_OUTPUT ?= true
UPLOAD_ENABLED ?= false
INCLUDE_DETAIL_DATASET ?= true
INCLUDE_AGGREGATE_DATASETS ?= true
INCLUDE_PLAYER_AGGREGATES ?= true
INCLUDE_TEAM_AGGREGATES ?= true
INCLUDE_MANAGER_AGGREGATES ?= true
INCLUDE_SEASON_AGGREGATES ?= true
INCLUDE_CAREER_AGGREGATES ?= true

.PHONY: render-job render-cronjob docker publish run-job run-bootstrap-job apply-cronjob apply-spaces-secret-example clean local-install local-run local-run-upload local-bootstrap local-bootstrap-upload local-run-docker local-run-sample local-run-sample-docker local-run-detail-only local-run-aggregates-only local-run-player-season local-run-team-career local-run-manager-season local-run-manager-career local-wizard bootstrap-estimate test

render-job:
	sed -e 's|%DATA_PIPELINE_IMAGE%|${IMAGE}|g' -e 's|%GIT_COMMIT_SHA%|${GIT_COMMIT_SHA}|g' ./kubernetes-job.yaml > ./kubernetes-job.rendered.yaml

render-cronjob:
	sed -e 's|%DATA_PIPELINE_IMAGE%|${IMAGE}|g' ./kubernetes-cronjob.yaml > ./kubernetes-cronjob.rendered.yaml

docker:
	docker build ./ -t mlb-data-pipeline

local-install:
	${PYTHON} -m venv ${VENV_DIR}
	${VENV_PYTHON} -m pip install --upgrade pip
	${VENV_PYTHON} -m pip install -r ./requirements.txt

local-wizard:
	${RUN_PYTHON} ./local_wizard.py

bootstrap-estimate:
	START_SEASON=1871 END_SEASON=${CURRENT_YEAR} OUTPUT_DIR="${OUTPUT_DIR}" \
	UPLOAD_ENABLED=${UPLOAD_ENABLED} \
	INCREMENTAL_MODE=false REQUIRE_EXISTING_SNAPSHOT=false TRAILER_MONTHS=${TRAILER_MONTHS} \
	LAHMAN_ENABLED=true LAHMAN_START_SEASON=${LAHMAN_START_SEASON} LAHMAN_END_SEASON=${LAHMAN_END_SEASON} \
	LAHMAN_PLAYER_MAPPING_PATH=${LAHMAN_PLAYER_MAPPING_PATH} LAHMAN_INCLUDE_OVERLAP=${LAHMAN_INCLUDE_OVERLAP} \
	SOURCE_OVERLAP_POLICY=${SOURCE_OVERLAP_POLICY} PRETTY_LOCAL_OUTPUT=false \
	SAMPLE_MODE=false SAMPLE_START_DATE= SAMPLE_END_DATE= \
	SAMPLE_MAX_ROWS=${SAMPLE_MAX_ROWS} SAMPLE_MAX_WINDOWS=${SAMPLE_MAX_WINDOWS} SAMPLE_RANDOM_STATE=${SAMPLE_RANDOM_STATE} \
	${RUN_PYTHON} ./bootstrap_estimate.py

local-run:
	mkdir -p "${OUTPUT_DIR}"
	START_SEASON=${START_SEASON} END_SEASON=${END_SEASON} OUTPUT_DIR="${OUTPUT_DIR}" \
	UPLOAD_ENABLED=false \
	INCREMENTAL_MODE=${INCREMENTAL_MODE} REQUIRE_EXISTING_SNAPSHOT=${REQUIRE_EXISTING_SNAPSHOT} TRAILER_MONTHS=${TRAILER_MONTHS} \
	LAHMAN_ENABLED=${LAHMAN_ENABLED} LAHMAN_START_SEASON=${LAHMAN_START_SEASON} LAHMAN_END_SEASON=${LAHMAN_END_SEASON} \
	LAHMAN_PLAYER_MAPPING_PATH=${LAHMAN_PLAYER_MAPPING_PATH} LAHMAN_INCLUDE_OVERLAP=${LAHMAN_INCLUDE_OVERLAP} \
	SOURCE_OVERLAP_POLICY=${SOURCE_OVERLAP_POLICY} \
	PRETTY_LOCAL_OUTPUT=${PRETTY_LOCAL_OUTPUT} \
	INCLUDE_DETAIL_DATASET=${INCLUDE_DETAIL_DATASET} INCLUDE_AGGREGATE_DATASETS=${INCLUDE_AGGREGATE_DATASETS} \
	INCLUDE_PLAYER_AGGREGATES=${INCLUDE_PLAYER_AGGREGATES} INCLUDE_TEAM_AGGREGATES=${INCLUDE_TEAM_AGGREGATES} \
	INCLUDE_MANAGER_AGGREGATES=${INCLUDE_MANAGER_AGGREGATES} INCLUDE_SEASON_AGGREGATES=${INCLUDE_SEASON_AGGREGATES} \
	INCLUDE_CAREER_AGGREGATES=${INCLUDE_CAREER_AGGREGATES} \
	SAMPLE_MODE=${SAMPLE_MODE} SAMPLE_START_DATE=${SAMPLE_START_DATE} SAMPLE_END_DATE=${SAMPLE_END_DATE} \
	SAMPLE_MAX_ROWS=${SAMPLE_MAX_ROWS} SAMPLE_MAX_WINDOWS=${SAMPLE_MAX_WINDOWS} SAMPLE_RANDOM_STATE=${SAMPLE_RANDOM_STATE} \
	${RUN_PYTHON} ./download_and_convert.py

local-run-upload:
	mkdir -p "${OUTPUT_DIR}"
	UPLOAD_ENABLED=true \
	START_SEASON=${START_SEASON} END_SEASON=${END_SEASON} OUTPUT_DIR="${OUTPUT_DIR}" \
	INCREMENTAL_MODE=${INCREMENTAL_MODE} REQUIRE_EXISTING_SNAPSHOT=${REQUIRE_EXISTING_SNAPSHOT} TRAILER_MONTHS=${TRAILER_MONTHS} \
	LAHMAN_ENABLED=${LAHMAN_ENABLED} LAHMAN_START_SEASON=${LAHMAN_START_SEASON} LAHMAN_END_SEASON=${LAHMAN_END_SEASON} \
	LAHMAN_PLAYER_MAPPING_PATH=${LAHMAN_PLAYER_MAPPING_PATH} LAHMAN_INCLUDE_OVERLAP=${LAHMAN_INCLUDE_OVERLAP} \
	SOURCE_OVERLAP_POLICY=${SOURCE_OVERLAP_POLICY} \
	PRETTY_LOCAL_OUTPUT=${PRETTY_LOCAL_OUTPUT} \
	INCLUDE_DETAIL_DATASET=${INCLUDE_DETAIL_DATASET} INCLUDE_AGGREGATE_DATASETS=${INCLUDE_AGGREGATE_DATASETS} \
	INCLUDE_PLAYER_AGGREGATES=${INCLUDE_PLAYER_AGGREGATES} INCLUDE_TEAM_AGGREGATES=${INCLUDE_TEAM_AGGREGATES} \
	INCLUDE_MANAGER_AGGREGATES=${INCLUDE_MANAGER_AGGREGATES} INCLUDE_SEASON_AGGREGATES=${INCLUDE_SEASON_AGGREGATES} \
	INCLUDE_CAREER_AGGREGATES=${INCLUDE_CAREER_AGGREGATES} \
	SAMPLE_MODE=${SAMPLE_MODE} SAMPLE_START_DATE=${SAMPLE_START_DATE} SAMPLE_END_DATE=${SAMPLE_END_DATE} \
	SAMPLE_MAX_ROWS=${SAMPLE_MAX_ROWS} SAMPLE_MAX_WINDOWS=${SAMPLE_MAX_WINDOWS} SAMPLE_RANDOM_STATE=${SAMPLE_RANDOM_STATE} \
	${RUN_PYTHON} ./download_and_convert.py

local-bootstrap:
	${MAKE} local-run START_SEASON=1871 END_SEASON=${CURRENT_YEAR} INCREMENTAL_MODE=false REQUIRE_EXISTING_SNAPSHOT=false LAHMAN_ENABLED=true

local-bootstrap-upload:
	${MAKE} local-run-upload START_SEASON=1871 END_SEASON=${CURRENT_YEAR} INCREMENTAL_MODE=false REQUIRE_EXISTING_SNAPSHOT=false LAHMAN_ENABLED=true

local-run-sample:
	mkdir -p "${OUTPUT_DIR}"
	START_SEASON=${START_SEASON} END_SEASON=${END_SEASON} OUTPUT_DIR="${OUTPUT_DIR}" \
	UPLOAD_ENABLED=false \
	INCREMENTAL_MODE=${INCREMENTAL_MODE} REQUIRE_EXISTING_SNAPSHOT=${REQUIRE_EXISTING_SNAPSHOT} TRAILER_MONTHS=${TRAILER_MONTHS} \
	LAHMAN_ENABLED=${LAHMAN_ENABLED} LAHMAN_START_SEASON=${LAHMAN_START_SEASON} LAHMAN_END_SEASON=${LAHMAN_END_SEASON} \
	LAHMAN_PLAYER_MAPPING_PATH=${LAHMAN_PLAYER_MAPPING_PATH} LAHMAN_INCLUDE_OVERLAP=${LAHMAN_INCLUDE_OVERLAP} \
	SOURCE_OVERLAP_POLICY=${SOURCE_OVERLAP_POLICY} \
	PRETTY_LOCAL_OUTPUT=${PRETTY_LOCAL_OUTPUT} \
	INCLUDE_DETAIL_DATASET=${INCLUDE_DETAIL_DATASET} INCLUDE_AGGREGATE_DATASETS=${INCLUDE_AGGREGATE_DATASETS} \
	INCLUDE_PLAYER_AGGREGATES=${INCLUDE_PLAYER_AGGREGATES} INCLUDE_TEAM_AGGREGATES=${INCLUDE_TEAM_AGGREGATES} \
	INCLUDE_MANAGER_AGGREGATES=${INCLUDE_MANAGER_AGGREGATES} INCLUDE_SEASON_AGGREGATES=${INCLUDE_SEASON_AGGREGATES} \
	INCLUDE_CAREER_AGGREGATES=${INCLUDE_CAREER_AGGREGATES} \
	SAMPLE_MODE=true SAMPLE_MAX_ROWS=${SAMPLE_MAX_ROWS} SAMPLE_MAX_WINDOWS=${SAMPLE_MAX_WINDOWS} SAMPLE_RANDOM_STATE=${SAMPLE_RANDOM_STATE} \
	${RUN_PYTHON} ./download_and_convert.py

local-run-docker: docker
	mkdir -p "${OUTPUT_DIR}"
	docker run --rm \
		-e UPLOAD_ENABLED=false \
		-e START_SEASON=${START_SEASON} \
		-e END_SEASON=${END_SEASON} \
		-e INCREMENTAL_MODE=${INCREMENTAL_MODE} \
		-e REQUIRE_EXISTING_SNAPSHOT=${REQUIRE_EXISTING_SNAPSHOT} \
		-e TRAILER_MONTHS=${TRAILER_MONTHS} \
		-e LAHMAN_ENABLED=${LAHMAN_ENABLED} \
		-e LAHMAN_START_SEASON=${LAHMAN_START_SEASON} \
		-e LAHMAN_END_SEASON=${LAHMAN_END_SEASON} \
		-e LAHMAN_PLAYER_MAPPING_PATH=${LAHMAN_PLAYER_MAPPING_PATH} \
		-e LAHMAN_INCLUDE_OVERLAP=${LAHMAN_INCLUDE_OVERLAP} \
		-e SOURCE_OVERLAP_POLICY=${SOURCE_OVERLAP_POLICY} \
		-e INCLUDE_DETAIL_DATASET=${INCLUDE_DETAIL_DATASET} \
		-e INCLUDE_AGGREGATE_DATASETS=${INCLUDE_AGGREGATE_DATASETS} \
		-e INCLUDE_PLAYER_AGGREGATES=${INCLUDE_PLAYER_AGGREGATES} \
		-e INCLUDE_TEAM_AGGREGATES=${INCLUDE_TEAM_AGGREGATES} \
		-e INCLUDE_MANAGER_AGGREGATES=${INCLUDE_MANAGER_AGGREGATES} \
		-e INCLUDE_SEASON_AGGREGATES=${INCLUDE_SEASON_AGGREGATES} \
		-e INCLUDE_CAREER_AGGREGATES=${INCLUDE_CAREER_AGGREGATES} \
		-e SAMPLE_MODE=${SAMPLE_MODE} \
		-e SAMPLE_START_DATE=${SAMPLE_START_DATE} \
		-e SAMPLE_END_DATE=${SAMPLE_END_DATE} \
		-e SAMPLE_MAX_ROWS=${SAMPLE_MAX_ROWS} \
		-e SAMPLE_MAX_WINDOWS=${SAMPLE_MAX_WINDOWS} \
		-e SAMPLE_RANDOM_STATE=${SAMPLE_RANDOM_STATE} \
		-e OUTPUT_DIR=/out \
		-v "${OUTPUT_DIR}":/out \
		mlb-data-pipeline

local-run-sample-docker: docker
	mkdir -p "${OUTPUT_DIR}"
	docker run --rm \
		-e UPLOAD_ENABLED=false \
		-e START_SEASON=${START_SEASON} \
		-e END_SEASON=${END_SEASON} \
		-e INCREMENTAL_MODE=${INCREMENTAL_MODE} \
		-e REQUIRE_EXISTING_SNAPSHOT=${REQUIRE_EXISTING_SNAPSHOT} \
		-e TRAILER_MONTHS=${TRAILER_MONTHS} \
		-e LAHMAN_ENABLED=${LAHMAN_ENABLED} \
		-e LAHMAN_START_SEASON=${LAHMAN_START_SEASON} \
		-e LAHMAN_END_SEASON=${LAHMAN_END_SEASON} \
		-e LAHMAN_PLAYER_MAPPING_PATH=${LAHMAN_PLAYER_MAPPING_PATH} \
		-e LAHMAN_INCLUDE_OVERLAP=${LAHMAN_INCLUDE_OVERLAP} \
		-e SOURCE_OVERLAP_POLICY=${SOURCE_OVERLAP_POLICY} \
		-e INCLUDE_DETAIL_DATASET=${INCLUDE_DETAIL_DATASET} \
		-e INCLUDE_AGGREGATE_DATASETS=${INCLUDE_AGGREGATE_DATASETS} \
		-e INCLUDE_PLAYER_AGGREGATES=${INCLUDE_PLAYER_AGGREGATES} \
		-e INCLUDE_TEAM_AGGREGATES=${INCLUDE_TEAM_AGGREGATES} \
		-e INCLUDE_MANAGER_AGGREGATES=${INCLUDE_MANAGER_AGGREGATES} \
		-e INCLUDE_SEASON_AGGREGATES=${INCLUDE_SEASON_AGGREGATES} \
		-e INCLUDE_CAREER_AGGREGATES=${INCLUDE_CAREER_AGGREGATES} \
		-e SAMPLE_MODE=true \
		-e SAMPLE_MAX_ROWS=${SAMPLE_MAX_ROWS} \
		-e SAMPLE_MAX_WINDOWS=${SAMPLE_MAX_WINDOWS} \
		-e SAMPLE_RANDOM_STATE=${SAMPLE_RANDOM_STATE} \
		-e OUTPUT_DIR=/out \
		-v "${OUTPUT_DIR}":/out \
		mlb-data-pipeline

local-run-detail-only:
	${MAKE} local-run \
		INCLUDE_DETAIL_DATASET=true \
		INCLUDE_AGGREGATE_DATASETS=false

local-run-aggregates-only:
	${MAKE} local-run \
		INCLUDE_DETAIL_DATASET=false \
		INCLUDE_AGGREGATE_DATASETS=true

local-run-player-season:
	${MAKE} local-run \
		INCLUDE_DETAIL_DATASET=false \
		INCLUDE_AGGREGATE_DATASETS=true \
		INCLUDE_PLAYER_AGGREGATES=true \
		INCLUDE_TEAM_AGGREGATES=false \
		INCLUDE_MANAGER_AGGREGATES=false \
		INCLUDE_SEASON_AGGREGATES=true \
		INCLUDE_CAREER_AGGREGATES=false

local-run-team-career:
	${MAKE} local-run \
		INCLUDE_DETAIL_DATASET=false \
		INCLUDE_AGGREGATE_DATASETS=true \
		INCLUDE_PLAYER_AGGREGATES=false \
		INCLUDE_TEAM_AGGREGATES=true \
		INCLUDE_MANAGER_AGGREGATES=false \
		INCLUDE_SEASON_AGGREGATES=false \
		INCLUDE_CAREER_AGGREGATES=true

local-run-manager-season:
	${MAKE} local-run \
		LAHMAN_ENABLED=true \
		INCLUDE_DETAIL_DATASET=false \
		INCLUDE_AGGREGATE_DATASETS=true \
		INCLUDE_PLAYER_AGGREGATES=false \
		INCLUDE_TEAM_AGGREGATES=false \
		INCLUDE_MANAGER_AGGREGATES=true \
		INCLUDE_SEASON_AGGREGATES=true \
		INCLUDE_CAREER_AGGREGATES=false

local-run-manager-career:
	${MAKE} local-run \
		LAHMAN_ENABLED=true \
		INCLUDE_DETAIL_DATASET=false \
		INCLUDE_AGGREGATE_DATASETS=true \
		INCLUDE_PLAYER_AGGREGATES=false \
		INCLUDE_TEAM_AGGREGATES=false \
		INCLUDE_MANAGER_AGGREGATES=true \
		INCLUDE_SEASON_AGGREGATES=false \
		INCLUDE_CAREER_AGGREGATES=true

test:
	${RUN_PYTHON} -m unittest discover -s ./tests -p 'test_*.py'

publish:
	docker tag mlb-data-pipeline ${IMAGE}
	docker push ${IMAGE}

run-bootstrap-job: render-job
	kubectl apply -f ./kubernetes-job.rendered.yaml

run-job: render-job
	kubectl apply -f ./kubernetes-job.rendered.yaml

apply-cronjob: render-cronjob
	kubectl apply -f ./kubernetes-cronjob.rendered.yaml

apply-spaces-secret-example:
	kubectl apply -f ./spaces-secret.example.yaml

clean:
	rm -f ./kubernetes-job.rendered.yaml ./kubernetes-cronjob.rendered.yaml
